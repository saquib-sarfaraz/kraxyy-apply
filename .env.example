# ==============================================================================
# KRAXYY - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001
WEB_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MongoDB User & Application Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/kraxyy_apply

# Cloudflare D1 Job-Index Database (Cloudflare Worker API or Local SQLite Fallback)
CLOUDFLARE_DATABASE_NAME=kraxyy-apply
CLOUDFLARE_DATABASE_ID=73cc8f32-0142-4910-8361-316178e54a9f
D1_WORKER_URL=http://localhost:8787
D1_WORKER_API_KEY=kraxyy_d1_worker_dev_secret_key
D1_SQLITE_PATH=./data/d1_jobs.sqlite

# Cloudinary File Storage (Resume Files, Profile Assets)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# AI Provider Configuration (groq | xai | openai | gemini | heuristic_fallback)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# JWT Authentication
JWT_SECRET=kraxyy_production_jwt_access_secret_min_32_chars_long
JWT_ACCESS_SECRET=kraxyy_production_jwt_access_secret_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=kraxyy_production_refresh_token_secret_rotate_regularly
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=kraxyy_secure_cookie_secret_key_random_string_here

# Extension Authentication & Pairing
EXTENSION_SECRET=kraxyy_extension_auth_secret_shared_hmac_32_bytes
EXTENSION_ID=
EXTENSION_PAIRING_CODE_EXPIRY_SECONDS=300

# Email Configuration (resend | console)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Kraxyy Apply <noreply@yourdomain.com>"
APP_URL=https://yourdomain.com

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info
